# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopeasy?retryWrites=true&w=majority

# JWT Authentication Secret (Use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret

# Allowed Frontend Origin (Render Static Site URL)
CLIENT_URL=https://shopeasy-fsd.onrender.com
